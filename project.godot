; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ball-buster250"
run/main_scene="uid://cdwfm5sw3e8gw"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.78933626, 0.15278566, 0.42805234, 1)
boot_splash/use_filter=false
boot_splash/image="uid://d25ygwjc4dcwu"
config/icon="uid://mjbjnxs2w137"
config/windows_native_icon="res://art/sprites/lilRatGirl-export.ico"

[audio]

buses/default_bus_layout=""

[autoload]

EventBus="*uid://cnoxydx2ita3i"
AudioKeeper="*uid://17k057u37nhb"
SceneKeeper="*uid://dbo5eckf1biul"
GameKeeper="*uid://2otdd4uyd4io"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://art/": "orange",
"res://assets/": "yellow",
"res://menus/": "green",
"res://resources/": "blue",
"res://scenes/": "purple",
"res://scripts/": "red",
"res://shaders/": "pink"
}

[global_group]

TravelNodes=""
SunSucc=""

